  "paths": {
    "/v1/incidents": {
      "get": {
        "summary": "List triaged incidents; filters apply before limit",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Object with incidents, category, limit. Each incident includes category and triage metadata."
          },
          "401": {
            "description": "Invalid bearer key"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Dependency unavailable"
          },
          "400": {
            "description": "Invalid category, limit or chain"
          }
        },
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "active",
              "enum": [
                "active",
                "review",
                "watch",
                "diagnostics",
                "retracted",
                "archived",
                "demo",
                "all"
              ]
            }
          },
          {
            "name": "chain_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 256
            }
          }
        ]
      }
    },
