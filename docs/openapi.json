    "/v1/findings": {
      "get": {
        "summary": "Poll findings with resumable stream cursors",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "Exclusive cursor; use next_after from the previous response.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum records scanned per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256,
              "default": 100
            }
          },
          {
            "name": "chain_id",
            "in": "query",
            "description": "Exact chain filter.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          {
            "name": "severity",
            "in": "query",
            "description": "Exact severity filter.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Object with stream, findings, next_after, scanned and page_full. Cursor advances over filtered records; page_full means another poll may be needed, not that more results are guaranteed."
          },
          "400": {
            "description": "Invalid or unknown query parameter"
          },
          "401": {
            "description": "Invalid bearer key"
          },
          "410": {
            "description": "Cursor predates stream retention floor"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
