    "/v1/incidents/{id}/revisions": {
      "get": {
        "summary": "Inspect incident revisions in ascending revision order",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Exclusive cursor; use next_after from the previous response.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum records scanned per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Object with incident_id, revisions, next_after and page_full. after and next_after are incident revision numbers, not stream cursors."
          },
          "400": {
            "description": "Invalid path or query parameter"
          },
          "401": {
            "description": "Invalid bearer key"
          },
          "404": {
            "description": "Incident not found"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
